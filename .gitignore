# ---- 依赖 ----
node_modules/
cloudfunctions/*/node_modules/
.venv/
venv/

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
__MACOSX/          # macOS 压缩包解出来的垃圾目录（从网上下模板时常见）

# ---- 抖音开发者工具产物 ----
miniprogram/dist/
miniprogram/.sourcemap/
*.log

# ---- 构建 / 临时 ----
dist/
build/
tmp/
.cache/

# ---- 本地文档工具（仅本机生成 Word / PDF 用，不入库）----
build_docx.py
build_pdf.py
*.docx
*.pdf

# ---- 设计稿源文件（体积大，按需放开）----
prototypes/**/*.psd
prototypes/**/*.sketch
prototypes/**/*.fig
prototypes/**/*.xd

# ---- 本地密钥 / 环境变量 ----
.env
.env.local
*.key
*.pem
