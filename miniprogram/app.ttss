/* app.ttss —— 全局样式
   分龄 UI 的视觉规范待 S1 设计定稿后统一替换 */

page {
  background-color: #0b1026;
  color: #e8ecf8;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 32rpx;
}

/* 占位提示块：骨架阶段用于标注待实现项，S2 落地后删除 */
.todo-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background-color: rgba(78, 161, 255, 0.15);
  color: #4ea1ff;
}

/* 带货商品位必须显著标识（《需求文档》9.1 广告合规） */
.ad-mark {
  font-size: 20rpx;
  color: #8a93b8;
  border: 1rpx solid #8a93b8;
  border-radius: 4rpx;
  padding: 0 8rpx;
}
