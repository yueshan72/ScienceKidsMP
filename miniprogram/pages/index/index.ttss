/* pages/index/index.ttss —— 首页样式
 * 从 prototypes/css/pages.css 的「首页」段搬运，px → rpx（数字未变）。
 * 颜色一律走 app.ttss 里的 token，本文件不得出现硬编码色值 ——
 * 否则主题切换会失灵。
 */

/* ---- 年龄段条 ---- */

.age-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--touch-min);
  padding: 0 var(--sp-3);
  color: var(--c-text-weak);
  font-size: var(--fs-sm);
}

/* ---- 主题入口大卡 ---- */

.topic-card {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 280rpx;
  padding: var(--sp-6) var(--sp-4);
  margin-top: var(--sp-2);
  background-color: var(--c-surface-2);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.topic-title {
  font-size: var(--fs-2xl);
  font-weight: 700;
}

.topic-sub {
  margin-top: var(--sp-2);
  color: var(--c-text-weak);
  font-size: var(--fs-sm);
}

/* ---- 内容流卡片 ---- */

.video-card {
  display: block;
  margin-bottom: var(--sp-3);
  padding: var(--sp-3);
  background-color: var(--c-surface);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.video-title {
  display: block;
  font-size: var(--fs-base);
  font-weight: 700;
}

.video-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-2);
  color: var(--c-text-weak);
  font-size: var(--fs-xs);
}

/* ---- 商品位 ---- */

.shop-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-3);
  padding: var(--sp-3);
  background-color: var(--c-surface);
  border-radius: var(--radius-card);
}

.shop-name {
  font-size: var(--fs-sm);
  color: var(--c-text-weak);
}

/* ---- 年龄段选择弹窗 ----
 * 用 position: fixed 铺满整个视口并居中。
 * 不能用 absolute：一旦内容比屏幕高，absolute 会相对整篇内容居中，
 * 弹窗就跑到屏幕外面去了。（这个坑在 HTML 原型阶段踩过一次。） */

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-4);
  background-color: var(--c-mask);
  z-index: 10;
}

.picker {
  width: 100%;
  padding: var(--sp-6) var(--sp-4);
  background-color: var(--c-surface);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.picker-title {
  font-size: var(--fs-xl);
  font-weight: 700;
  text-align: center;
}

.picker-tip {
  margin-top: var(--sp-2);
  margin-bottom: var(--sp-5);
  color: var(--c-text-weak);
  font-size: var(--fs-sm);
  text-align: center;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  /* 分龄选择是首次进入的关键动作，热区给得比常规更大 */
  min-height: 112rpx;
  margin-bottom: var(--sp-3);
  background-color: var(--c-surface-2);
  border: 2rpx solid var(--c-line);
  border-radius: var(--radius-sm);
  font-size: var(--fs-lg);
}
