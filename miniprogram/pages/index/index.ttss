/* pages/index/index.ttss —— 首页样式
 * 从 prototypes/css/pages.css 的「首页」段搬运，px → rpx（数字未变）。
 * 颜色一律走 app.ttss 里的 token，本文件不得出现硬编码色值 ——
 * 否则主题切换会失灵。
 */

/* ---- 年龄段条 ---- */

.age-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--touch-min);
  padding: 0 var(--sp-3);
  color: var(--c-text-weak);
  font-size: var(--fs-sm);
}

/* ---- 主题入口大卡 ---- */

.topic-card {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 280rpx;
  padding: var(--sp-6) var(--sp-4);
  margin-top: var(--sp-2);
  background-color: var(--c-fx-space);
  background-image: linear-gradient(135deg, var(--c-fx-space) 0%, var(--c-space) 100%);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

/* 星云：两团大范围柔光，和关卡舞台同一套 token */
.topic-nebula {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  pointer-events: none;
}

.topic-nebula-a {
  left: 8%;
  top: 12%;
  box-shadow: 0 0 200rpx 90rpx var(--c-nebula-a);
}

.topic-nebula-b {
  right: 4%;
  bottom: 6%;
  box-shadow: 0 0 180rpx 80rpx var(--c-nebula-b);
}

/* 星野：位置/大小/闪烁节奏由 utils/starfield.js 生成 */
.topic-stars {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  pointer-events: none;
}

.topic-star {
  position: absolute;
  border-radius: 50%;
  background-color: var(--c-space-star);
  animation-name: topic-star-twinkle;
  animation-iteration-count: infinite;
  animation-timing-function: ease-in-out;
}

@keyframes topic-star-twinkle {
  0%, 100% { opacity: .25; transform: scale(.8); }
  50%      { opacity: .95; transform: scale(1.1); }
}

.topic-title {
  position: relative;
  z-index: 1;
  color: var(--c-chip-text);
  font-size: var(--fs-2xl);
  font-weight: 700;
}

.topic-sub {
  position: relative;
  z-index: 1;
  margin-top: var(--sp-2);
  color: var(--c-space-star);
  font-size: var(--fs-sm);
}

/* ---- 内容流卡片 ---- */

.video-card {
  display: block;
  margin-bottom: var(--sp-3);
  padding: var(--sp-3);
  background-color: var(--c-surface);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

/* ---- 视频封面（左） + 标题/简介（右） ---- */

.video-main {
  display: flex;
  align-items: center;
}

.video-cover-wrap {
  position: relative;
  width: 240rpx;
  height: 135rpx;
  flex-shrink: 0;
  margin-right: var(--sp-3);
  background-color: var(--c-surface-2);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.video-cover {
  display: block;
  width: 100%;
  height: 100%;
}

.video-duration {
  position: absolute;
  right: var(--sp-1);
  bottom: var(--sp-1);
  padding: 2rpx var(--sp-1);
  border-radius: 4rpx;
  background-color: var(--c-overlay);
  color: var(--c-on-overlay);
  font-size: var(--fs-xs);
  line-height: 1.6;
}

.video-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.video-desc {
  margin-top: var(--sp-1);
  color: var(--c-text-weak);
  font-size: var(--fs-xs);
  line-height: 1.5;
}

.video-title {
  display: block;
  font-size: var(--fs-base);
  font-weight: 700;
}

.video-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-2);
  color: var(--c-text-weak);
  font-size: var(--fs-xs);
}

/* ---- 商品位 ---- */

.shop-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-3);
  padding: var(--sp-3);
  background-color: var(--c-surface);
  border-radius: var(--radius-card);
}

.shop-name {
  font-size: var(--fs-sm);
  color: var(--c-text-weak);
}

/* ---- 年龄段选择弹窗 ----
 * 用 position: fixed 铺满整个视口并居中。
 * 不能用 absolute：一旦内容比屏幕高，absolute 会相对整篇内容居中，
 * 弹窗就跑到屏幕外面去了。（这个坑在 HTML 原型阶段踩过一次。） */

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-4);
  background-color: var(--c-mask);
  z-index: 10;
}

.picker {
  width: 100%;
  padding: var(--sp-6) var(--sp-4);
  background-color: var(--c-surface);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.picker-title {
  font-size: var(--fs-xl);
  font-weight: 700;
  text-align: center;
}

.picker-tip {
  margin-top: var(--sp-2);
  margin-bottom: var(--sp-5);
  color: var(--c-text-weak);
  font-size: var(--fs-sm);
  text-align: center;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  /* 分龄选择是首次进入的关键动作，热区给得比常规更大 */
  min-height: 112rpx;
  margin-bottom: var(--sp-3);
  background-color: var(--c-surface-2);
  border: 2rpx solid var(--c-line);
  border-radius: var(--radius-sm);
  font-size: var(--fs-lg);
}

/* ---- 收藏 ---- */

.video-foot-right {
  display: flex;
  align-items: center;
  margin-left: auto;
}

.fav {
  margin-right: var(--sp-2);
  font-size: var(--fs-lg);
  color: var(--c-gold);
}

/* ---- 监护人同意（§9.1） ---- */

.consent {
  width: 100%;
  padding: var(--sp-5) var(--sp-4);
  background-color: var(--c-surface);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.consent-title {
  font-size: var(--fs-xl);
  font-weight: 700;
  text-align: center;
}

.consent-text {
  margin: var(--sp-3) 0 var(--sp-5);
  color: var(--c-text-weak);
  font-size: var(--fs-sm);
  line-height: 1.7;
}

.consent-decline {
  margin-top: var(--sp-4);
  padding: var(--sp-2);
  text-align: center;
  color: var(--c-text-weak);
  font-size: var(--fs-sm);
}

.consent-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--sp-8) var(--sp-5);
  background-color: var(--c-surface);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.consent-block-icon {
  font-size: 96rpx;
}

.consent-block-title {
  margin-top: var(--sp-3);
  font-size: var(--fs-xl);
  font-weight: 700;
}

.consent-block-text {
  margin: var(--sp-2) 0 var(--sp-5);
  color: var(--c-text-weak);
  font-size: var(--fs-sm);
  line-height: 1.7;
  text-align: center;
}

.consent-block-btn {
  width: 100%;
}

/* 鼠标悬停时卡片底色变化（页面 TTSS 优先级高于全局 :hover，需在这里补） */
@media (hover: hover) {
  .video-card:hover {
    background-color: var(--c-surface-2);
  }
}
