<!-- pages/index/index.ttml —— 首页 -->
<view class="container">

  <!-- 分龄入口：首次进入弹窗选择（《需求文档》4.1） -->
  <view class="age-bar" tt:if="{{ageGroup}}">
    <text>当前年龄段：{{ageGroup}}</text>
    <text class="link" bindtap="onOpenAgePicker">修改</text>
  </view>

  <!-- 主题入口：太空主题大图（《需求文档》4.1） -->
  <view class="topic-card" bindtap="onTapTopic">
    <text class="topic-title">太空 / 宇宙</text>
    <text class="topic-sub">去动手试一试</text>
    <text class="todo-badge">待接内容</text>
  </view>

  <!-- 内容流：按年龄段推荐的短视频卡片列表（《需求文档》4.1 / 4.2） -->
  <view class="section-title">为你推荐</view>
  <view tt:if="{{loading}}" class="hint">加载中…</view>
  <view tt:elif="{{contentList.length === 0}}" class="hint">
    内容流待实现（S2）—— 见 接口契约 §3 与《开发计划书》S2
  </view>
  <view tt:else>
    <view class="video-card" tt:for="{{contentList}}" tt:key="_id">
      <text>{{item.title}}</text>
      <!-- 视频卡片下方关联商品位，需显著标识（《需求文档》9.1 广告合规） -->
      <text class="ad-mark">推广</text>
    </view>
  </view>

</view>

<!-- 年龄段选择弹窗 -->
<view class="mask" tt:if="{{showAgePicker}}">
  <view class="picker">
    <view class="picker-title">选择年龄段</view>
    <view class="picker-tip">我们会按年龄推荐合适难度的内容</view>
    <view
      class="picker-item"
      tt:for="{{ageOptions}}"
      tt:key="*this"
      data-age="{{item}}"
      bindtap="onPickAge"
    >{{item}}</view>
    <view class="picker-cancel" tt:if="{{ageGroup}}" bindtap="onCloseAgePicker">取消</view>
  </view>
</view>
