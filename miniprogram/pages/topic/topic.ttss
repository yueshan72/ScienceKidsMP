/* pages/topic/topic.ttss —— 主题内容页样式
 * 这是【新设计】的一页：原型阶段只做了首页和关卡页，主题页从未设计过。
 * 沿用既有设计语言与 app.ttss 的 token，不引入新色值。
 */

/* ---- 主题头部 ---- */

.topic-head {
  display: flex;
  flex-direction: column;
  padding: var(--sp-6) var(--sp-4);
  background-color: var(--c-surface-2);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.topic-head-title {
  font-size: var(--fs-2xl);
  font-weight: 700;
}

.topic-head-intro {
  margin-top: var(--sp-2);
  color: var(--c-text-weak);
  font-size: var(--fs-sm);
}

/* ---- 区块小注（如「已完成 1 / 2」）---- */

.side-note {
  margin-bottom: var(--sp-3);
  color: var(--c-text-weak);
  font-size: var(--fs-xs);
}

/* ---- 科普视频卡片 ---- */

.video-card {
  display: block;
  margin-bottom: var(--sp-3);
  padding: var(--sp-3);
  background-color: var(--c-surface);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

/* ---- 视频封面（左） + 标题/简介（右） ---- */

.video-main {
  display: flex;
  align-items: center;
}

.video-cover-wrap {
  position: relative;
  width: 240rpx;
  height: 135rpx;
  flex-shrink: 0;
  margin-right: var(--sp-3);
  background-color: var(--c-surface-2);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.video-cover {
  display: block;
  width: 100%;
  height: 100%;
}

.video-duration {
  position: absolute;
  right: var(--sp-1);
  bottom: var(--sp-1);
  padding: 2rpx var(--sp-1);
  border-radius: 4rpx;
  background-color: var(--c-overlay);
  color: var(--c-on-overlay);
  font-size: var(--fs-xs);
  line-height: 1.6;
}

.video-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.video-desc {
  margin-top: var(--sp-1);
  color: var(--c-text-weak);
  font-size: var(--fs-xs);
  line-height: 1.5;
}

.video-title {
  display: block;
  font-size: var(--fs-base);
  font-weight: 700;
}

.video-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-2);
  color: var(--c-text-weak);
  font-size: var(--fs-xs);
}

.video-foot-right {
  display: flex;
  align-items: center;
  margin-left: auto;
}

.fav {
  margin-right: var(--sp-2);
  font-size: var(--fs-lg);
  color: var(--c-gold);
}

/* ---- 关卡列表 ---- */

.level-item {
  display: flex;
  align-items: center;
  min-height: 120rpx;      /* 关卡是核心动作，热区给足 */
  margin-bottom: var(--sp-3);
  padding: var(--sp-3);
  background-color: var(--c-surface);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

/* 已通关的关卡降低存在感，把注意力留给没做的 */
.level-item.is-done {
  opacity: .62;
}

.level-order {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: var(--sp-3);
  background-color: var(--c-surface-2);
  border-radius: var(--radius-pill);
  color: var(--c-accent);
  font-size: var(--fs-base);
  font-weight: 700;
}

.level-main {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.level-name {
  font-size: var(--fs-base);
  font-weight: 700;
}

.level-point {
  margin-top: 4rpx;
  color: var(--c-text-weak);
  font-size: var(--fs-xs);
}

.level-state {
  color: var(--c-accent);
  font-size: var(--fs-xs);
}

.level-item.is-done .level-state {
  color: var(--c-text-weak);
}

/* ---- 商品位 ---- */

.shop-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-3);
  padding: var(--sp-3);
  background-color: var(--c-surface);
  border-radius: var(--radius-card);
}

.shop-name {
  font-size: var(--fs-sm);
  color: var(--c-text-weak);
}

/* 鼠标悬停时卡片底色变化（页面 TTSS 优先级高于全局 :hover，需在这里补） */
@media (hover: hover) {
  .video-card:hover,
  .level-item:hover {
    background-color: var(--c-surface-2);
  }
}
