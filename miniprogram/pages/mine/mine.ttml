<!-- pages/mine/mine.ttml —— 我的
     依据：《需求文档》4.1 / 4.3 / 4.5 / §9.1 儿童信息合规
     本次补齐：进度 / 徽章 / 打卡日历 / 收藏 / 更正年龄 / 删除数据 / 撤回同意
-->
<view class="page theme-{{theme}}">
  <view class="container">

    <!-- 头部 -->
    <view class="head">
      <text class="head-title">我的</text>
      <text class="head-sub">{{ageLabel}} · {{consent.granted ? '监护人已同意' : '尚未同意'}}</text>
    </view>

    <!-- 统计 -->
    <view class="stats">
      <view class="stat">
        <text class="stat-num">{{stats.doneLevels}}/{{stats.totalLevels}}</text>
        <text class="stat-label">通关</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{stats.streak}}</text>
        <text class="stat-label">连续打卡</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{stats.checkinDays}}</text>
        <text class="stat-label">累计打卡</text>
      </view>
    </view>

    <!-- 闯关进度 -->
    <view class="section-title">闯关进度</view>
    <view class="card level-card"
          tt:for="{{levelList}}"
          tt:key="_id"
          data-id="{{item._id}}"
          bindtap="onTapLevel">
      <view class="level-row">
        <text class="level-name">{{item.order}}. {{item.name}}</text>
        <text class="stars">{{item.starsText}}</text>
      </view>
      <text class="science">{{item.sciencePoint}}</text>
    </view>

    <!-- 徽章 -->
    <view class="section-title">徽章</view>
    <view tt:if="{{badges.length === 0}}" class="hint card">
      全部通关可获得「太空探索者」徽章
    </view>
    <view tt:else class="badge-row">
      <view class="badge-item" tt:for="{{badges}}" tt:key="badgeId">
        <text class="badge-icon">{{item.icon}}</text>
        <text class="badge-name">{{item.name}}</text>
      </view>
    </view>

    <!-- 打卡 -->
    <view class="section-title">打卡</view>
    <view class="card">
      <view class="row">
        <text>连续打卡</text>
        <text class="value">{{streak}} 天</text>
      </view>

      <!-- 最近 14 天 -->
      <view class="calendar">
        <view class="cal-item {{item.done ? 'is-done' : ''}} {{item.today ? 'is-today' : ''}}"
              tt:for="{{calendar}}"
              tt:key="date">
          <text class="cal-day">{{item.day}}</text>
        </view>
      </view>

      <button class="btn checkin-btn" bindtap="onCheckin">今日打卡</button>
    </view>

    <!-- 收藏 -->
    <view class="section-title">我的收藏</view>
    <view tt:if="{{favorites.length === 0}}" class="hint card">
      在首页或主题页点 ☆ 收藏喜欢的内容
    </view>
    <view tt:else class="card">
      <view class="fav-item" tt:for="{{favorites}}" tt:key="_id">
        <text>⭐ {{item.title}}</text>
      </view>
    </view>

    <!-- 隐私与数据（《需求文档》§9.1 硬性要求） -->
    <view class="section-title">隐私与数据</view>
    <view class="card privacy-card">
      <view class="row" bindtap="onOpenAgePicker">
        <text>更正年龄段</text>
        <text class="value">{{ageLabel}} ›</text>
      </view>
      <view class="row" bindtap="onDeleteData">
        <text>删除我的数据</text>
        <text class="value">›</text>
      </view>
      <view class="row" bindtap="onWithdrawConsent">
        <text>撤回监护人同意</text>
        <text class="value">{{consent.granted ? '›' : '已撤回'}}</text>
      </view>
      <view class="privacy-note">
        我们只收集年龄段、闯关进度、徽章和打卡记录，不收集位置与联系方式。
        删除数据或撤回同意后，已采集的内容将被清空且无法恢复。
      </view>
    </view>

  </view>

  <!-- 年龄段选择弹窗（更正入口，可随时修改） -->
  <view class="mask" tt:if="{{showAgePicker}}">
    <view class="picker">
      <view class="picker-title">更正年龄段</view>
      <view class="picker-tip">我们会按年龄推荐合适难度的内容，随时可以修改</view>
      <view class="picker-item"
            tt:for="{{ageOptions}}"
            tt:key="value"
            data-age="{{item.value}}"
            bindtap="onPickAge">{{item.label}}</view>
      <view class="picker-cancel" bindtap="onCloseAgePicker">取消</view>
    </view>
  </view>

</view>
