<!-- pages/level/level.ttml —— 闯关详情页（互动实验）
     从 prototypes/level.html 搬运。这是项目里最复杂的一个页面。
     依据：《需求文档》4.3 互动实验闯关（核心留存）

     与原型的两处适配：
       ① 原型用 [data-anim="launch"] / [data-scene="rocket"] 属性选择器；
          TTSS 对属性选择器的支持没把握，改用 class 驱动（anim-xxx / scene-xxx）。
       ② 装饰物的旋转拆成两层：外层管定位、内层管旋转。
          否则旋转会和升空动画的 transform 互相覆盖。
-->

<view class="page theme-{{theme}}">
  <view class="container {{fx ? fx.containerClass : ''}}">

    <view tt:if="{{error}}" class="hint">{{error}}</view>

    <block tt:else>
      <!-- 关卡标题 -->
      <view class="level-name">{{level.name}}</view>
      <view class="science-point">科普点：{{level.sciencePoint}}</view>

      <!-- 引导语：来自 interactionConfig.prompt -->
      <view class="level-prompt">{{prompt}}</view>

      <!--
        互动舞台：interactionConfig 解释器的宿主。
        舞台内的一切（装饰、目标、提示）都由页面按【关卡数据】渲染 ——
        引擎不认识任何具体关卡。
      -->
      <view class="stage scene-{{sceneKey}} {{stageClass}} {{shakeClass}}">

        <!-- 常态舞台也是深空场景：星云 + 网格 + 星点，不参与交互 -->
        <view class="fx-nebula fx-nebula-a"></view>
        <view class="fx-nebula fx-nebula-b"></view>
        <view tt:for="{{stageGrid}}" tt:key="key"
              class="fx-grid-line {{item.cls}}" style="{{item.style}}"></view>
        <view class="stage-stars">
          <view tt:for="{{stars}}" tt:key="key" class="stage-star" style="{{item.style}}"></view>
        </view>

        <!-- 场景装饰物。纯展示，不可点。矢量版由 KK 风格视图绘制。 -->
        <view class="stage-deco anim-{{item.anim}}"
              tt:for="{{deco}}"
              tt:key="id"
              style="{{item.wrapStyle}}">
          <view class="stage-deco-inner" style="{{item.rotStyle}}">
            <view tt:if="{{item.visual === 'rocket'}}" class="fx-art fx-art--rocket">
              <view class="rk-trail"></view>
              <view class="rk-glow"></view>
              <view class="rk-body">
                <view class="rk-shine"></view>
                <view class="rk-window"></view>
              </view>
              <view class="rk-nose"></view>
              <view class="rk-fin rk-fin-l"></view>
              <view class="rk-fin rk-fin-r"></view>
              <view class="rk-flame"><view class="rk-flame-inner"></view></view>
            </view>
            <view tt:if="{{item.visual === 'moon'}}" class="fx-art fx-art--moon">
              <view class="mn-shadow"></view>
              <view class="mn-shine"></view>
              <view class="mn-crater mn-c1"></view>
              <view class="mn-crater mn-c2"></view>
              <view class="mn-crater mn-c3"></view>
            </view>
            <view tt:if="{{item.visual === 'sun'}}" class="fx-art fx-art--sun">
              <view class="sun-ray sun-ray-1"></view>
              <view class="sun-ray sun-ray-2"></view>
              <view class="sun-ray sun-ray-3"></view>
              <view class="sun-ray sun-ray-4"></view>
              <view class="sun-core"></view>
            </view>
            <text tt:if="{{!item.visual}}">{{item.icon}}</text>
          </view>
        </view>

        <!-- 撞击留下的坑：动画前就渲染，靠 delay 在撞击时刻出现，之后一直保留 -->
        <view tt:for="{{craters}}" tt:key="key" class="stage-crater" style="{{item.style}}"></view>

        <!-- 可点目标。坐标由引擎转成百分比字符串，中心点语义。 -->
        <view class="stage-target {{item.hit ? 'is-hit' : ''}} {{item.wrong ? 'is-wrong' : ''}}"
              tt:for="{{targets}}"
              tt:key="id"
              data-id="{{item.id}}"
              style="{{item.styleStr}}"
              bindtap="onTapTarget">
          <view class="target-icon-wrap">
            <view tt:if="{{item.visual === 'earth'}}" class="tgt-art tgt-earth">
              <view class="tgt-earth-land"></view>
            </view>
            <view tt:if="{{item.visual === 'mars'}}" class="tgt-art tgt-mars"></view>
            <view tt:if="{{item.visual === 'jupiter'}}" class="tgt-art tgt-jupiter">
              <view class="tgt-jupiter-band"></view>
            </view>
            <view tt:if="{{item.visual === 'moon'}}" class="tgt-art tgt-moon"></view>
            <view tt:if="{{item.visual === 'comet'}}" class="tgt-art tgt-comet">
              <view class="tgt-comet-tail"></view>
              <view class="tgt-comet-core"></view>
            </view>
            <view tt:if="{{item.visual === 'fire'}}" class="tgt-art tgt-fire"></view>
            <text tt:if="{{item.visual === 'star'}}" class="tgt-star">★</text>
            <text tt:if="{{!item.visual && item.icon}}" class="target-icon">{{item.icon}}</text>
          </view>
        </view>

        <!-- 失败提示（缺口 G3：1 秒瞬时提示，随后自动消失） -->
        <view tt:if="{{showHint}}" class="stage-hint">{{hintText}}</view>

        <!-- 成功动画：舞台内效果层（升空 / 坠落）。
             位移由 .fx-mover 的 CSS 变量驱动，缩放由 .fx-body--* 负责。 -->
        <view tt:if="{{fx && !fx.fullscreen}}"
              class="fx-layer {{fx.exiting ? 'is-exiting' : ''}}">
          <!-- 深空底 + 网格 + 星点 + 静态矢量道具 -->
          <view tt:if="{{fx.space}}" class="fx-space">
            <view class="fx-nebula fx-nebula-a"></view>
            <view class="fx-nebula fx-nebula-b"></view>
            <view tt:for="{{fx.grid}}" tt:key="key"
                  class="fx-grid-line {{item.cls}}" style="{{item.style}}"></view>
            <view tt:for="{{fx.spaceStars}}" tt:key="key"
                  class="fx-space-star" style="{{item.style}}"></view>
            <view tt:for="{{fx.props}}" tt:key="key"
                  class="fx-prop" style="{{item.style}}">
              <view tt:if="{{item.visual === 'moon'}}" class="fx-art fx-art--moon">
                <view class="mn-shadow"></view>
                <view class="mn-shine"></view>
                <view class="mn-crater mn-c1"></view>
                <view class="mn-crater mn-c2"></view>
                <view class="mn-crater mn-c3"></view>
              </view>
            </view>
          </view>

          <!-- 冲击波 / 闪光 / 粒子 / 残影 / 演员 -->
          <view tt:for="{{fx.shockwaves}}" tt:key="key"
                class="fx-shockwave" style="{{item.style}}"></view>
          <view tt:for="{{fx.flashes}}" tt:key="key"
                class="fx-flash" style="{{item.style}}"></view>
          <view tt:for="{{fx.particles}}" tt:key="key"
                class="fx-particle {{item.cls}}" style="{{item.style}}"></view>
          <view tt:for="{{fx.ghosts}}" tt:key="key"
                class="fx-ghost" style="{{item.wrapStyle}}">
            <view class="fx-mover" style="{{item.moverStyle}}">
              <view class="fx-anchor" style="{{item.anchorStyle}}">
                <view class="fx-body {{item.bodyClass}}" style="{{item.bodyStyle}}">
                  <view class="fx-rotator" style="{{item.rotatorStyle}}">
                    <text class="fx-icon" style="{{item.iconStyle}}">{{item.icon}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
          <view tt:for="{{fx.items}}" tt:key="key" class="fx-mover" style="{{item.moverStyle}}">
            <view class="fx-anchor {{item.chargeClass}}"
                  style="{{item.anchorStyle}}{{item.chargeStyle}}">
              <view class="fx-body {{item.bodyClass}}" style="{{item.bodyStyle}}">
                <view tt:if="{{item.halo}}" class="fx-halo"></view>
                <view class="fx-rotator" style="{{item.rotatorStyle}}">
                  <view tt:if="{{item.visual === 'rocket'}}" class="fx-art fx-art--rocket">
                    <view class="rk-trail"></view>
                    <view class="rk-glow"></view>
                    <view class="rk-body">
                      <view class="rk-shine"></view>
                      <view class="rk-window"></view>
                    </view>
                    <view class="rk-nose"></view>
                    <view class="rk-fin rk-fin-l"></view>
                    <view class="rk-fin rk-fin-r"></view>
                    <view class="rk-flame"><view class="rk-flame-inner"></view></view>
                  </view>
                  <view tt:if="{{item.visual === 'comet'}}" class="fx-art fx-art--comet">
                    <view class="cm-tail cm-tail-3"></view>
                    <view class="cm-tail cm-tail-2"></view>
                    <view class="cm-tail cm-tail-1"></view>
                    <view class="cm-core"></view>
                  </view>
                  <text tt:if="{{!item.visual}}" class="fx-icon"
                        style="{{item.iconStyle}}">{{item.icon}}</text>
                </view>
                <text tt:if="{{item.flame}}" class="fx-flame"
                      style="{{item.flame.style}}">{{item.flame.icon}}</text>
              </view>
            </view>
            <!-- 爆点单独放在 mover 层：跟着位移走到终点，但不受 actor 淡出影响 -->
            <text tt:if="{{item.impact}}" class="fx-impact"
                  style="{{item.anchorStyle}}{{item.impact.style}}">{{item.impact.icon}}</text>
          </view>

          <!-- 底部字幕：Kurzgesagt 式的白字 + 金线，不再用胶囊 -->
          <view tt:if="{{successText}}" class="fx-caption"
                style="{{fx.captionStyle}}">{{successText}}</view>
        </view>

      </view>

      <!-- 通关奖励。星级由「云函数」判定，前端只负责展示。
           《接口契约》§3.2：奖励发放必须走云函数，前端不可信。 -->
      <view tt:if="{{reward}}" class="reward">
        <text class="reward-label">已通关</text>
        <view class="reward-stars">
          <text tt:for="{{reward.starList}}" tt:key="key"
                class="reward-star {{item.on ? 'is-on' : 'is-off'}}"
                style="{{item.style}}">{{item.char}}</text>
        </view>
        <!-- 积分 V1.0 仅展示：首次通关显示 +10，重复通关不显示 -->
        <text tt:if="{{reward.pointsText}}" class="reward-points">{{reward.pointsText}}</text>
      </view>

      <view tt:if="{{showBadge}}" class="badge">🏅 获得徽章：太空探索者</view>

      <!--
        注意：老骨架这里是一个手动的「完成实验」按钮，它与契约
        「不通关不给星」冲突（缺口 G8）—— 前端可绕过交互直接调 complete 拿星，
        而【没有任何互动，点一下就通关】。
        已改为「再试一次」，与交互状态绑定。
      -->
      <view tt:if="{{reward}}" class="level-actions">
        <button class="btn" bindtap="onReset">再试一次</button>
      </view>

    </block>

  </view>

  <!-- 成功动画：页面级全屏层（地球放大）。
       .stage 有 640rpx + overflow:hidden，地球必须放在舞台外才能覆盖全屏。 -->
  <view tt:if="{{fx && fx.fullscreen}}"
        class="fx-full {{fx.exiting ? 'is-exiting' : ''}}">
    <view class="fx-nebula fx-nebula-a"></view>
    <view class="fx-nebula fx-nebula-b"></view>
    <view tt:for="{{fx.grid}}" tt:key="key"
          class="fx-grid-line {{item.cls}}" style="{{item.style}}"></view>
    <view tt:for="{{fx.stars}}" tt:key="key" class="fx-star" style="{{item.style}}"></view>
    <view tt:for="{{fx.items}}" tt:key="key" class="fx-mover" style="{{item.moverStyle}}">
      <view class="fx-anchor" style="{{item.anchorStyle}}">
        <view class="fx-body {{item.bodyClass}}" style="{{item.bodyStyle}}">
          <view tt:if="{{item.halo}}" class="fx-halo"></view>
          <view class="fx-rotator" style="{{item.rotatorStyle}}">
            <view tt:if="{{item.visual === 'earth'}}" class="fx-art fx-art--earth">
              <view class="er-land er-l1"></view>
              <view class="er-land er-l2"></view>
              <view class="er-land er-l3"></view>
              <view class="er-land er-l4"></view>
              <view class="er-land er-l5"></view>
              <view class="er-cloud er-c1"></view>
              <view class="er-cloud er-c2"></view>
            </view>
            <text tt:if="{{!item.visual}}" class="fx-icon"
                  style="{{item.iconStyle}}">{{item.icon}}</text>
          </view>
          <text tt:if="{{item.flame}}" class="fx-flame"
                style="{{item.flame.style}}">{{item.flame.icon}}</text>
        </view>
      </view>
      <text tt:if="{{item.impact}}" class="fx-impact"
            style="{{item.anchorStyle}}{{item.impact.style}}">{{item.impact.icon}}</text>
    </view>

    <view tt:if="{{successText}}" class="fx-caption"
          style="{{fx.captionStyle}}">{{successText}}</view>
  </view>
</view>
