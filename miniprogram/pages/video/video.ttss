/* pages/video/video.ttss —— 短视频播放页
   颜色/间距/圆角一律取 app.ttss 的 token。 */

.video-box {
  margin-bottom: var(--sp-4);
  background-color: var(--c-surface-2);
  border-radius: var(--radius-card);
  overflow: hidden;
}

.video {
  display: block;
  width: 100%;
  height: 420rpx;
}

.video-placeholder {
  height: 420rpx;
  padding: var(--sp-4);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.ph-icon {
  font-size: 96rpx;
}

.ph-title {
  margin-top: var(--sp-2);
  font-size: var(--fs-lg);
  font-weight: 700;
}

.ph-tip {
  margin-top: var(--sp-1);
  color: var(--c-text-weak);
  font-size: var(--fs-sm);
}

.video-title {
  display: block;
  font-size: var(--fs-xl);
  font-weight: 700;
}

.video-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-2);
  color: var(--c-text-weak);
  font-size: var(--fs-sm);
}

/* ---- 点赞 / 收藏 ---- */

.actions {
  display: flex;
  margin: var(--sp-4) 0;
}

.action {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--touch-min);
  margin-right: var(--sp-2);
  background-color: var(--c-surface);
  border-radius: var(--radius-pill);
  color: var(--c-text-weak);
  font-size: var(--fs-base);
}

.action:last-child {
  margin-right: 0;
}

.action.is-on {
  color: var(--c-accent);
  font-weight: 700;
}

.action-icon {
  margin-right: 8rpx;
  font-size: var(--fs-lg);
}

.go-btn {
  margin-bottom: var(--sp-4);
}

/* ---- 商品位（与首页/主题页一致） ---- */

.shop-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-3);
  padding: var(--sp-3);
  background-color: var(--c-surface);
  border-radius: var(--radius-card);
}

.shop-name {
  color: var(--c-text-weak);
  font-size: var(--fs-sm);
}
